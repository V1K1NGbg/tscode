# Shared by interactive and non-interactive Bash; custom .bashrc files may source it too.
if [ -s /packages/nvm/nvm.sh ]; then
    . /packages/nvm/nvm.sh
fi

# Refresh this shell after installing Node interactively.
tscode-install() {
    command tscode-install "$@" || return
    if [ -s /packages/nvm/nvm.sh ]; then
        . /packages/nvm/nvm.sh
    fi
}

# Workspace controls; plain `exit` still closes only the current shell pane.
tscode-exit() { tmux kill-session -t tscode; }
tscode-detach() { tmux detach-client; }

# Commands used by the default pane list.
shell() { exec /bin/bash -i; }
carbonyl() { command carbonyl --no-sandbox "$@"; }
